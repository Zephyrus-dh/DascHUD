<Window x:Class="DascHUD.MainWindow"
        WindowStartupLocation="Manual"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DascHUD" 
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent" 
        Topmost="True" 
        ShowInTaskbar="False" 
        Loaded="Window_Loaded">
    
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Space Mono" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" BlurRadius="1" ShadowDepth="0" Opacity="0.2" />
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Canvas x:Name="AirspaceCanvas" Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

        <StackPanel x:Name="HudContainer">
            <TextBlock x:Name="TimeText" FontSize="20" FontWeight="Bold" />
            <TextBlock x:Name="DateText" FontSize="15" Margin="0,0,0,10" />
            <TextBlock x:Name="WeatherText" FontSize="10" Margin="0,0,0,5" />
            
            <TextBlock x:Name="DisasterText" FontSize="10" FontWeight="Bold" Foreground="#32CD32" MaxWidth="450" TextWrapping="Wrap" Margin="0,0,0,5" />
            <TextBlock x:Name="EmergencyText" FontSize="12" FontWeight="Bold" Foreground="#FF4444" MaxWidth="450" TextWrapping="Wrap" Margin="0,0,0,5" />
            <TextBlock x:Name="FlightText" FontSize="10" MaxWidth="450" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Window>